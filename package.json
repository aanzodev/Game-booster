{
  "name": "game-booster",
  "productName": "Game Booster",
  "version": "1.0.0",
  "description": "Safe, reversible FPS, network and cleanup tweaks for Windows, macOS, Linux and Chromebook.",
  "main": "main.js",
  "author": { "name": "Game Booster", "email": "noreply@example.com" },
  "homepage": "https://github.com/",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "@vscode/sudo-prompt": "^9.3.1"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.gamebooster.desktop",
    "publish": null,
    "productName": "Game Booster",
    "files": ["main.js", "preload.js", "src/**/*", "tweaks/**/*", "package.json"],
    "directories": { "buildResources": "build", "output": "dist" },
    "win": { "target": ["nsis", "portable"], "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "mac": { "target": ["dmg"], "category": "public.app-category.utilities", "icon": "build/icon.png" },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility",
      "icon": "build/icon.png",
      "maintainer": "Game Booster"
    }
  }
}
